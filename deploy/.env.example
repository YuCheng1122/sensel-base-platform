# Copy to a private file outside Git; never commit deployed values.
# Use URL-safe alphanumeric database passwords, or URL-encode DATABASE_URL credentials.
POSTGRES_PASSWORD=
# Generate independently: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
# Generate independently: openssl rand -hex 32
AGENT_SHARED_SECRET=
WEB_PORT=3000
# External browser origin, without a path; must match HTTPS reverse proxy.
PUBLIC_APP_URL=https://analysis.example.com
# For production prefer immutable digests after release instead of mutable version tags.
WEB_IMAGE=ghcr.io/avocadoai-lab/sensel-base-platform-web:v0.1.0
MIGRATE_IMAGE=ghcr.io/avocadoai-lab/sensel-base-platform-migrate:v0.1.0
AGENT_IMAGE=ghcr.io/avocadoai-lab/sensel-base-platform-agent:v0.1.0
# Comma-separated exact permitted API base URLs for configurable model endpoints.
MODEL_ALLOWED_ENDPOINTS=
