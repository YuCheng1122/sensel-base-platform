DATABASE_URL=postgresql://sensel:sensel@127.0.0.1:5432/sensel
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Generate a separate random secret, shared by Web and Agent only.
AGENT_SHARED_SECRET=replace-with-a-random-secret-at-least-32-characters
AGENT_URL=http://127.0.0.1:8001
MODEL_ALLOWED_ENDPOINTS=https://api.openai.com/v1
APP_ENV=development
AGENT_ALLOW_FAKE=false
# Local HTTP only. Production HTTPS must use true.
SECURE_COOKIES=false
# Bootstrap command only; remove from runtime after initial account setup.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-unique-password-12-to-72-characters
PUBLIC_APP_URL=http://localhost:3000
